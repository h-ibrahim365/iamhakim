iamhakim.com {
    encode zstd gzip

    # Deploy webhook
    handle /hooks/iamhakim-deploy {
        reverse_proxy 127.0.0.1:9001
    }

    # robots.txt must never fall back to Angular index.html
    handle /robots.txt {
        root * /opt/iamhakim/web
        header Cache-Control "public, max-age=300, must-revalidate"
        file_server
    }

    # sitemap.xml must never fall back to Angular index.html
    handle /sitemap.xml {
        root * /opt/iamhakim/web
        header Cache-Control "public, max-age=300, must-revalidate"
        file_server
    }

    # API → ASP.NET Core
    handle /api/* {
        reverse_proxy 127.0.0.1:5172
    }

    # SignalR realtime hub (WebSockets pass through automatically)
    handle /hubs/* {
        reverse_proxy 127.0.0.1:5172
    }

    # Hashed Angular assets (main-XXXXXXXX.js, styles-XXXXXXXX.css, etc.) — cache 1 an, immutable
    @hashed_assets {
        path_regexp \.[A-Z0-9]{6,}\.(js|css|woff2?)$
    }
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # Self-hosted fonts (pas de hash mais nom stable)
    @fonts {
        path /fonts/*.woff2
    }
    header @fonts Cache-Control "public, max-age=31536000, immutable"

    # Autres statiques (favicons, og-image.png, manifest, humans.txt) — cache modéré
    @static {
        path *.svg *.ico *.png *.jpg *.jpeg *.webp *.avif *.txt *.xml *.webmanifest
    }
    header @static Cache-Control "public, max-age=3600, must-revalidate"

    # Prerendered pages + SPA fallback:
    #   /en/projects  → tries /en/projects (file) → /en/projects/index.html (prerendered) ✓
    #   /unknown-id   → all fail → /index.html (SPA fallback)
    handle {
        root * /opt/iamhakim/web
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Security headers (global)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; script-src-elem 'self' https://challenges.cloudflare.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://iamhakim.com wss://iamhakim.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; child-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        -Server
    }
}

www.iamhakim.com {
    redir https://iamhakim.com{uri} permanent
}
