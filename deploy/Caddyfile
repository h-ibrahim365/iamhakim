iamhakim.com {
	encode zstd gzip

	# Deploy webhook
	handle /hooks/iamhakim-deploy {
		reverse_proxy 127.0.0.1:9001
	}

	# Root / and legacy un-prefixed URLs → localized route (permanent).
	# Each redir matches only the exact bare path, never /en/* itself.
	redir / /en 301
	redir /projects /en/projects 301
	redir /services /en/services 301
	redir /about /en/about 301
	redir /flow /en/flow 301
	redir /status /en/status 301
	redir /book /en/book 301
	redir /book/manage /en/book/manage 301
	redir /privacy /en/privacy 301

	# .well-known/ (ACME, security.txt, assetlinks.json, etc.) - sert les fichiers existants
	handle /.well-known/* {
		root * /opt/iamhakim/web
		file_server
	}

	# robots.txt must never fall back to Angular index.html
	handle /robots.txt {
		root * /opt/iamhakim/web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# sitemap.xml must never fall back to Angular index.html
	handle /sitemap.xml {
		root * /opt/iamhakim/web
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	# API → ASP.NET Core
	handle /api/* {
		reverse_proxy 127.0.0.1:5172
	}

	# SignalR realtime hub (WebSockets pass through automatically)
	handle /hubs/* {
		reverse_proxy 127.0.0.1:5172
	}

	# Hashed Angular assets (main-XXXXXXXX.js, styles-XXXXXXXX.css, etc.) - cache 1 an, immutable
	@hashed_assets {
		path_regexp \.[A-Z0-9]{6,}\.(js|css|woff2?)$
	}
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	# Autres statiques (favicons, og-image.png, etc.) - cache modéré
	@static {
		path *.svg *.ico *.png *.jpg *.jpeg *.webp *.avif *.txt *.xml
	}
	header @static Cache-Control "public, max-age=3600, must-revalidate"

	# Bloque les dotfiles (.env, .git, .aws, .ssh, .npmrc…)
	# Le handle /.well-known/* plus haut intercepte déjà ces chemins légitimes
	@dotfiles path_regexp (^|/)\.
	handle @dotfiles {
		respond 404
	}

	# Bloque les probes classiques (WordPress, PHP, phpMyAdmin, cgi-bin, vendor leaks…)
	@probes {
		path *.php *.php* *.aspx *.asp *.jsp *.cgi /wp-* /xmlrpc.php /phpmyadmin* /phpMyAdmin* /cgi-bin/* /vendor/* /storage/*
	}
	handle @probes {
		respond 404
	}

	# book/manage: client-rendered only (private, token-based link, never
	# prerendered) - serve the CSR shell directly at a normal 200. Marked
	# noindex: it's Disallow'd in robots.txt already, but that only stops
	# crawling, not indexing if a link ever leaks somewhere.
	@bookManage path /*/book/manage
	handle @bookManage {
		root * /opt/iamhakim/web
		header X-Robots-Tag "noindex"
		rewrite * /index.csr.html
		file_server
	}

	# Serve prerendered pages (/en, /en/projects, etc.) and static assets.
	# No CSR-shell fallback here on purpose (see handle_errors below):
	# anything that isn't a real file or a real prerendered route/index.html
	# should 404, not silently succeed.
	handle {
		root * /opt/iamhakim/web
		try_files {path} {path}/index.html
		file_server
	}

	# Anything unmatched above (bad locale code, made-up route, etc.) used
	# to fall through to the CSR shell at 200 - a soft 404: Google indexed
	# nonexistent URLs as if they were real pages. Serve the same shell
	# (it renders Angular's own NotFound UI once hydrated) but keep the
	# real 404 status and mark it noindex.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			root * /opt/iamhakim/web
			header X-Robots-Tag "noindex"
			rewrite * /index.csr.html
			file_server
		}
	}

	# Security headers (global)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}

	import /etc/caddy/iamhakim-csp.caddy
}

www.iamhakim.com {
	# Collapse the root path straight to /en in one hop instead of
	# www -> apex -> /en (2 hops). Everything else keeps the generic form.
	redir / https://iamhakim.com/en 301
	redir /* https://iamhakim.com{uri} permanent
}
import /etc/caddy/sites/*.caddy
