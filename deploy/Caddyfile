# /etc/caddy/Caddyfile
#
# Caddy automatically obtains and renews HTTPS certificates from Let's Encrypt.
# Make sure iamhakim.com (and www) point to this server's IP before reloading.

iamhakim.com, www.iamhakim.com {
    encode zstd gzip

    # API → ASP.NET Core
    handle /api/* {
        reverse_proxy 127.0.0.1:5172
    }

    # SignalR realtime hub (WebSockets pass through automatically)
    handle /hubs/* {
        reverse_proxy 127.0.0.1:5172
    }

    # Hashed static assets (Angular emits *.<hash>.{js,css}) — cache hard
    @hashed_assets {
        path_regexp \.[a-f0-9]{8,}\.(js|css|woff2?|svg|png|jpg|jpeg|webp|avif|ico)$
    }
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # Other static assets (non-hashed: favicons, robots.txt, sitemap.xml, og-image)
    @static {
        path *.svg *.ico *.png *.jpg *.jpeg *.webp *.avif *.woff *.woff2 *.txt *.xml
    }
    header @static Cache-Control "public, max-age=3600, must-revalidate"

    # Everything else → Angular SSR (Node)
    handle {
        reverse_proxy 127.0.0.1:4000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        # NOTE: tune CSP carefully. 'unsafe-inline' for styles is required by Angular's inlineCritical CSS.
        # If you self-host fonts, remove fonts.googleapis.com and fonts.gstatic.com from connect-src / style-src / font-src.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://iamhakim.com wss://iamhakim.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        -Server
    }
}

# Redirect bare http and www handled automatically by Caddy.
