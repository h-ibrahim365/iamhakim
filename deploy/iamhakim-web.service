# /etc/systemd/system/iamhakim-web.service
# Angular SSR server (Node, port interne 4000, derrière Caddy)
[Unit]
Description=iamhakim web (Angular SSR)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/iamhakim/web
# The SSR entry point is dist/frontend/server/server.mjs after `npm run build`
ExecStart=/usr/bin/node /opt/iamhakim/web/dist/frontend/server/server.mjs
Restart=always
RestartSec=5
User=iamhakim
Group=iamhakim

Environment=NODE_ENV=production
Environment=PORT=4000

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
